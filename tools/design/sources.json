{
  "schemaVersion": 1,
  "profile": "native-node-v1",
  "node": ">=24.3.0 <25",
  "packages": {
    "style-dictionary": {
      "source": "3rdparty/style-dictionary",
      "packageRoot": "",
      "manifest": "package.json",
      "version": "5.7.0",
      "files": [
        "lib/**/*.js"
      ],
      "exports": {
        ".": "./lib/StyleDictionary.js",
        "./fs": "./lib/fs-node.js",
        "./enums": "./lib/enums/index.js",
        "./utils": "./syncwatch-utils.js"
      },
      "requires": [
        "deepmerge",
        "glob",
        "chalk",
        "change-case",
        "colorjs.io",
        "is-plain-obj",
        "json5",
        "tinycolor2"
      ],
      "excludedDependencies": {
        "@bundled-es-modules/memfs": "Browser filesystem; Node condition uses node:fs.",
        "@zip.js/zip.js": "ZIP conversion/download utilities; excluded from the native generator utils entry.",
        "commander": "Upstream CLI; the product uses its own API entry.",
        "prettier": "JavaScript/TypeScript output formats; native profile permits JSON and custom syncwatch formats only."
      },
      "sourceBindings": {
        "@bundled-es-modules/deepmerge": {
          "package": "deepmerge",
          "imports": {
            "@bundled-es-modules/deepmerge": "deepmerge"
          },
          "reason": "Use the original CommonJS implementation directly through Node ESM interop."
        },
        "@bundled-es-modules/glob": {
          "package": "glob",
          "imports": {
            "@bundled-es-modules/glob": "glob/raw"
          },
          "reason": "Use the original unbundled Node entry directly."
        },
        "path-unified": {
          "package": null,
          "imports": {
            "path-unified/posix": "node:path/posix",
            "path-unified/win32": "node:path/win32"
          },
          "reason": "Use the standard Node path API; no adapted Node source is redistributed."
        }
      }
    },
    "deepmerge": {
      "source": "3rdparty/design-deepmerge",
      "packageRoot": "",
      "manifest": "package.json",
      "version": "4.3.1",
