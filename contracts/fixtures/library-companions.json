      ],
      "audio": [
        "film.en.wav"
      ],
      "subtitles": [
        "film.en.srt",
        "Film.RU.srt"
      ],
      "expected": [
        {
          "video": "Film.mkv",
          "folder": true,
          "audio": [],
          "subtitles": [
            "Film.RU.srt"
          ]
        }
      ]
    },
    {
      "id": "insensitive-name-rules",
      "caseSensitive": false,
      "videos": [
        "Film.mkv"
      ],
      "audio": [
        "film.en.wav"
      ],
      "subtitles": [
        "film.en.srt",
        "Film.RU.srt"
