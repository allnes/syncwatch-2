{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "folder-extras-one-level",
      "caseSensitive": true,
      "videos": [
        "one/film.mkv",
        "two/film.mkv"
      ],
      "audio": [
        "one/audio/commentary.flac"
      ],
      "subtitles": [
        "two/extras/deeper/film.srt"
      ],
      "expected": [
        {
          "video": "one/film.mkv",
          "folder": true,
          "audio": [],
          "subtitles": [
            "two/extras/deeper/film.srt"
          ]
        },
        {
          "video": "two/film.mkv",
          "folder": false,
          "audio": [],
          "subtitles": [
            "two/extras/deeper/film.srt"
          ]
        }
      ]
    },
    {
      "id": "multiple-dots-global-duplicates",
      "caseSensitive": false,
      "videos": [
        "one/a.mkv",
        "two/A.B.mp4",
        ".mkv"
      ],
      "audio": [],
      "subtitles": [
        "elsewhere/a.b.en.srt",
        "elsewhere/A.RU.srt",
        "other/a.b.en.srt",
        "ab.srt",
        ".en.srt"
      ],
      "expected": [
        {
          "video": "one/a.mkv",
          "folder": false,
          "audio": [],
          "subtitles": [
            "elsewhere/A.RU.srt",
            "elsewhere/a.b.en.srt",
            "other/a.b.en.srt"
          ]
        },
        {
          "video": "two/A.B.mp4",
          "folder": false,
          "audio": [],
          "subtitles": [
            "elsewhere/a.b.en.srt",
            "other/a.b.en.srt"
          ]
        },
        {
          "video": ".mkv",
          "folder": true,
          "audio": [],
          "subtitles": [
            ".en.srt"
          ]
        }
      ]
    },
    {
